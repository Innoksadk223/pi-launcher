{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PI Launcher",
  "mainBinaryName": "pi-launcher",
  "version": "3.2.0",
  "identifier": "local.pi.project-launcher",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PI 项目启动器",
        "width": 780,
        "height": 640,
        "minWidth": 520,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#eee8da"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
